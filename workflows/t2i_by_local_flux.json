        "clip": ["2", 0]
      }
    },
    {
      "id": "2",
      "type": "FLUX.clip",
      "pos": [250, 300],
      "inputs": {}
    },
    {
      "id": "3",
      "type": "FLUX.model",
      "pos": [250, 450],
      "inputs": {}
    },
    {
      "id": "4",
      "type": "KSampler",
      "pos": [650, 350],
      "inputs": {
        "seed": "$seed",
        "steps": 28,
        "cfg": 3.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1,
        "model": ["3", 0],
        "positive": ["1", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0]
