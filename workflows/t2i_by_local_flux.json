    {
      "id": "5",
      "type": "CLIPTextEncode",
      "pos": [450, 500],
      "inputs": {
        "text": "",
        "clip": ["2", 0]
      }
    },
    {
      "id": "6",
      "type": "EmptyLatentImage",
      "pos": [650, 150],
      "inputs": {
        "width": 1024,
