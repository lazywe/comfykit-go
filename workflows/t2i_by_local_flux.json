    },
    {
      "id": "8",
      "type": "SaveImage",
      "pos": [1050, 350],
      "inputs": {
        "images": ["7", 0],
        "filename_prefix": "$output.result"
      }
    }
  ],
  "links": [
    ["2", 0, "1", 1],
    ["2", 0, "5", 1],
    ["3", 0, "4", 0],
    ["1", 0, "4", 1],
    ["5", 0, "4", 2],
    ["6", 0, "4", 3],
    ["4", 0, "7", 0],
    ["7", 0, "8", 0]
  ],
  "groups": [],
  "config": {},
  "__metadata__": {
    "title": "Text-to-Image with FLUX",
    "params": {
